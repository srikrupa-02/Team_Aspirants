# GEMINI_API_KEY: Required for Gemini AI API calls (codebase analysis, embeddings, RAG, README & skills).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OPENAI_API_KEY: Optional alternative provider for OpenAI GPT-4o and text-embeddings.
# If provided, can be toggled in server settings.
OPENAI_API_KEY=""

# GITHUB_TOKEN: Optional personal access token for higher GitHub API rate limits (5,000 req/hr vs 60 req/hr).
GITHUB_TOKEN=""

# SUPABASE_URL & SUPABASE_SERVICE_ROLE_KEY: Optional external Supabase PostgreSQL sync.
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# JWT_SECRET: Secret for signing internal authentication sessions.
JWT_SECRET="buildrex-production-jwt-secret-key-change-in-prod"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

